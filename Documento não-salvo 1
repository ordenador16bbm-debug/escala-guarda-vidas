<!DOCTYPE html><html lang="pt-BR"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Escala de Guarda-Vidas Civis</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#f3f6f4;color:#222}header{background:#0b5d1e;color:#fff;padding:18px;text-align:center}header h1{margin:0;font-size:22px}header p{margin:6px 0}.container{max-width:1200px;margin:18px auto;padding:0 12px}.card{background:#fff;border-radius:12px;padding:18px;margin-bottom:18px;box-shadow:0 2px 10px #0001}.login{max-width:430px;margin:45px auto}h2{margin-top:0;color:#0b5d1e}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.grid-2{grid-template-columns:repeat(2,1fr)}.grid-1{grid-template-columns:1fr}label{display:block;font-weight:bold;margin:8px 0 5px}input,select,button{width:100%;padding:11px;border:1px solid #bbb;border-radius:8px;font-size:15px}button{cursor:pointer;font-weight:bold}.btn{background:#0b5d1e;color:white;margin-top:12px}.btn2{background:#e8f2ea;color:#0b5d1e;margin-top:10px}.btn-export{width:auto;display:inline-block;margin-right:10px;padding:10px 18px;font-size:14px;border-radius:8px}.top{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px}.top button{width:auto;background:#b00020;color:white}.status{padding:10px;border-radius:8px;background:#eef7ef;margin-top:10px}.status-alerta{background:#fff3cd;color:#856404;border-left:4px solid #ffc107}.hidden{display:none}.calendar{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;margin-top:12px}.day{background:#f8faf8;border:1px solid #ccc;min-height:52px}.day.selected{background:#0b5d1e;color:white}.day.has{font-weight:bold;border:2px solid #198754}.day.outro{border-color:#b00020;background:#fff0f2}.day small{display:block;font-size:10px;margin-top:3px}.table-wrap{overflow:auto}table{border-collapse:collapse;width:100%;min-width:700px}th,td{border:1px solid #ccc;padding:7px;text-align:center}th{background:#dfeee2;position:sticky;top:0}td:nth-child(4){font-weight:bold}td button{width:auto;padding:5px 9px}.bloqueado{background:#f3f4f6;color:#666;cursor:not-allowed;opacity:.8}.muted{color:#777;font-weight:normal!important}@media(max-width:700px){.grid,.grid-2{grid-template-columns:1fr}.calendar{gap:4px}.day{padding:7px 2px;font-size:13px}}
</style>
<style>
.table-wrap{overflow-x:auto;width:100%;border:1px solid #d9dee7;border-radius:12px;background:#fff}.table-wrap table{border-collapse:separate;border-spacing:0;min-width:max-content}.table-wrap th,.table-wrap td{min-width:82px;height:46px;padding:5px 6px;text-align:center;border-right:1px solid #e1e5eb;border-bottom:1px solid #e1e5eb;white-space:nowrap;font-size:12px}.table-wrap th{position:sticky;top:0;background:#f3f6fa;z-index:2;cursor:pointer}.table-wrap th small{display:block;font-size:10px;font-weight:500;opacity:.7}.table-wrap .fixo{position:sticky;z-index:3;background:#fff}.table-wrap th.fixo{z-index:4;background:#f3f6fa;cursor:default}.posto-col{left:0;min-width:62px!important}.horario-col{left:62px;min-width:92px!important}.table-wrap td.dia-atual{background:#eef6ff}.table-wrap th.dia-atual{background:#dbeeff}.table-wrap td span{font-size:11px}.table-wrap .vazio{opacity:.25}.mini-excluir{display:block;margin:2px auto 0;border:0;background:transparent;cursor:pointer;font-weight:700;font-size:14px;line-height:14px}.area-exportar{margin:15px 0;padding:12px;background:#eef7ef;border-radius:10px;border-left:4px solid #0b5d1e}.info-mes{background:#eef7ef;padding:10px;border-radius:8px;margin:10px 0}@media(max-width:700px){.table-wrap th,.table-wrap td{min-width:76px}.horario-col{left:62px;min-width:88px!important}}
</style>
<!-- Bibliotecas -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
</head>
<body>
<header><h1>🏖️ Escala de Guarda-Vidas Civis</h1><p>Turno: 07:30 às 18:30 · Postos 00 a 23 · Itapoá - SC</p></header>
<div id="login" class="container"><div class="card login"><h2>🔐 Acesso</h2><p>Versão de teste com nomes fictícios.</p><label>Usuário</label><select id="usuarioLogin"><option>ADMIN</option><option>GUARDA 01</option><option>GUARDA 02</option><option>GUARDA 03</option><option>GUARDA 04</option><option>GUARDA 05</option></select><label>Senha</label><input id="senhaLogin" type="password" placeholder="123456"><button class="btn" id="entrarBtn">Entrar</button><div id="loginMsg" class="status hidden"></div></div></div>
<div id="app" class="hidden"><div class="container"><div class="card top"><div>👤 <b id="usuarioNome"></b> — <span id="perfil"></span></div><button id="sairBtn">Sair</button></div>

<!-- Área do ADMIN: pode fixar o mês -->
<div id="adminConfig" class="card hidden">
  <h2>⚙️ Configuração da Escala</h2>
  <div class="grid grid-2">
    <div>
      <label>Mês da Escala (fixo para todos)</label>
      <select id="mesFixo"></select>
    </div>
    <div>
      <label>Status</label>
      <div style="padding:10px;background:#eef7ef;border-radius:8px">
        <span id="statusFixo">Não fixado</span>
      </div>
    </div>
  </div>
  <button class="btn" id="fixarMesBtn">📌 Fixar este mês para todos</button>
  <div class="status status-alerta">
    💡 Ao fixar, os guardas só conseguem lançar neste mês e não alteram o que já foi preenchido por outros.
  </div>
</div>

<!-- Área do Guarda: mostra o mês fixo sem permitir alterar -->
<div id="guardaMesFixo" class="card hidden">
  <h2>📅 Escala — <span id="mesExibicao"></span></h2>
  <div class="info-mes">
    📌 Escala fixada pela administração — <b>não é possível alterar o mês</b>.
  </div>
</div>

<div id="lancarArea" class="card hidden">
  <h2>📅 Lançar escala</h2>
  <div id="mesSelectDiv" class="grid grid-2">
    <div>
      <label>Mês</label>
      <select id="mes"></select>
    </div>
    <div>
      <label>Posto</label>
      <select id="posto"></select>
    </div>
  </div>
  <div id="mesSelectFixo" class="grid grid-1 hidden">
    <div>
      <label>Posto</label>
      <select id="postoFixo"></select>
    </div>
  </div>
  <div class="grid grid-2" id="guardaSelectDiv">
    <div>
      <label>Guarda-Vidas</label>
      <select id="guarda"></select>
    </div>
  </div>
  <div class="status">🕢 Horário: <b>07:30 às 18:30</b></div>
  <h3>Calendário</h3>
  <div id="calendario" class="calendar"></div>
  <button class="btn" id="salvarBtn">💾 Confirmar minha escala</button>
  <button class="btn2" id="limparBtn">Limpar meus campos</button>
  <div id="msg" class="status hidden"></div>
</div>

<div class="card">
  <h2>🏖️ Escala mensal — <span id="tituloMes"></span></h2>
  <div id="areaExportar" class="area-exportar hidden">
    <strong>📤 Exportar escala:</strong>
    <div style="margin-top:8px">
      <button class="btn btn-export" id="btnPDF">📄 Gerar PDF</button>
      <button class="btn2 btn-export" id="btnXLS">📊 Gerar Planilha</button>
    </div>
  </div>
  <div id="resumo"></div>
  <div class="table-wrap">
    <table><thead><tr><th>Posto</th><th>Horário</th><th>Dia</th><th>Guarda-Vidas</th><th>Ação</th></tr></thead><tbody id="tabela"></tbody></table>
  </div>
</div>

</div></div>

<script>
const guardas=['GUARDA 01','GUARDA 02','GUARDA 03','GUARDA 04','GUARDA 05'];
const postos=Array.from({length:24},(_,i)=>String(i).padStart(2,'0'));
const meses=['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
const diasSemanaLetra = ['D','S','T','Q','Q','S','S'];
const KEY='escalaGVCivisTeste';
const KEY_MES_FIXO='escalaMesFixo';
let usuario=null, diaSelecionado=new Date().getDate(), escala={};
try{escala=JSON.parse(localStorage.getItem(KEY)||'{}')||{}}catch(e){escala={}};
const $=id=>document.getElementById(id);
function ano(){return new Date().getFullYear()}
function mesFixo(){const v=localStorage.getItem(KEY_MES_FIXO);return v!==null?Number(v):null}
function mesAtual(){const fixo=mesFixo();return fixo!==null?fixo:Number($('mes').value)}
function chave(d){return `${ano()}-${String(mesAtual()+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`}
function diasNoMes(){return new Date(ano(), mesAtual()+1, 0).getDate()}

// === EXPORTAÇÃO ===
function gerarDadosExportacao(){
  const mesNome = meses[mesAtual()];
  const anoAtual = ano();
  const n = diasNoMes();
  const dados = [];
  const cabecalho = ['Posto', 'Horário'];
  for(let d=1;d<=n;d++){
    const data = new Date(anoAtual, mesAtual(), d);
    cabecalho.push(`${d}\n${diasSemanaLetra[data.getDay()]}`);
  }
  dados.push(cabecalho);
  for(const p of postos){
    const linha = [p, '07:30–18:30'];
    for(let d=1;d<=n;d++){
      const k = `${ano()}-${String(mesAtual()+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
      linha.push((escala[k]||{})[p] || '');
    }
    dados.push(linha);
  }
  return {dados, mesNome, anoAtual};
}

async function exportarPDF(){
  if(usuario!=='ADMIN'){mostrar('⚠️ Apenas administrador pode exportar.');return;}
  const {dados, mesNome, anoAtual} = gerarDadosExportacao();
  const {jsPDF} = window.jspdf;
  const doc = new jsPDF('l','mm','a4');
  doc.setFillColor(11,93,30);
  doc.rect(0,0,297,32,'F');
  doc.setTextColor(255,255,255);
  doc.setFontSize(18);doc.setFont('helvetica','bold');
  doc.text('ESCALA DE SERVIÇO – GUARDA-VIDAS CIVIS', 148, 14, {align:'center'});
  doc.setFontSize(12);doc.setFont('helvetica','normal');
  doc.text(`Prefeitura Municipal de Itapoá / SC — ${mesNome} de ${anoAtual}`, 148, 22, {align:'center'});
  doc.text(`Turno: 07:30 às 18:30 · Postos 00 a 23 · Atualizado em: ${new Date().toLocaleDateString('pt-BR')}`, 148, 29, {align:'center'});
  doc.setTextColor(0,0,0);
  doc.autoTable({
    startY: 40,
    head: [dados[0]],
    body: dados.slice(1),
    theme: 'grid',
    styles: {fontSize:7.2,cellPadding:2.2,lineColor:[200,200,200]},
    headStyles: {fillColor:[11,93,30],textColor:255,fontStyle:'bold',fontSize:8},
    alternateRowStyles: {fillColor:[249,251,249]},
    columnStyles: {0:{cellWidth:22,fontStyle:'bold'},1:{cellWidth:30}}
  });
  const pgs=doc.getNumberOfPages();
  for(let i=1;i<=pgs;i++){doc.setPage(i);doc.setFontSize(8);doc.setTextColor(120,120,120);doc.text(`Página ${i} de ${pgs}`,148,205,{align:'center'});}
  doc.save(`Escala_Guardas_${mesNome}_${anoAtual}.pdf`);
  mostrar('✅ PDF gerado!');
}

function exportarXLS(){
  if(usuario!=='ADMIN'){mostrar('⚠️ Apenas administrador pode exportar.');return;}
  const {dados, mesNome, anoAtual} = gerarDadosExportacao();
  const cab=[
    [`ESCALA DE SERVIÇO – GUARDA-VIDAS CIVIS – ${mesNome}/${anoAtual}`],
    ['Prefeitura Municipal de Itapoá / SC'],
    ['Turno: 07:30 às 18:30 | Postos 00 a 23'],
    [`Gerado em: ${new Date().toLocaleDateString('pt-BR')}`],
    []
  ];
  const wb=XLSX.utils.book_new();
  const ws=XLSX.utils.aoa_to_sheet([...cab,...dados]);
  ws['!cols']=[{wch:10},{wch:18},...Array(dados[0].length-2).fill({wch:11})];
  ws['!freeze']={x:2,y:cab.length+1};
  XLSX.utils.book_append_sheet(wb,ws,`${mesNome}_${anoAtual}`);
  XLSX.writeFile(wb,`Escala_Guardas_${mesNome}_${anoAtual}.xlsx`);
  mostrar('✅ Planilha gerada!');
}
// === FIM EXPORTAÇÃO ===

function preencherSelects(){
  [$('mesFixo'),$('mes')].forEach(s=>{s.innerHTML='';meses.forEach((m,i)=>s.add(new Option(m,i)));});
  $('mes').value=new Date().getMonth();$('mesFixo').value=new Date().getMonth();
  postos.forEach(p=>{
    $('posto').add(new Option('Posto '+p,p));
    $('postoFixo').add(new Option('Posto '+p,p));
  });
  guardas.forEach(g=>$('guarda').add(new Option(g,g)));
}

function desenhar(){
  const fixo=mesFixo();
  const mNome=meses[mesAtual()];
  $('tituloMes').textContent = `${mNome} / ${ano()}`;
  $('mesExibicao').textContent = `${mNome} / ${ano()}`;
  $('statusFixo').textContent = fixo!==null ? `✅ Fixado: ${meses[fixo]}` : 'Não fixado — clique para fixar';
  $('areaExportar').classList.toggle('hidden', usuario!=='ADMIN');
  $('adminConfig').classList.toggle('hidden', usuario!=='ADMIN');
  $('lancarArea').classList.remove('hidden');
  // Controle de exibição de mês
  if(usuario==='ADMIN' && fixo===null){
    $('mesSelectDiv').classList.remove('hidden');
    $('mesSelectFixo').classList.add('hidden');
    $('guardaMesFixo').classList.add('hidden');
  }else{
    $('mesSelectDiv').classList.add('hidden');
    $('mesSelectFixo').classList.remove('hidden');
    $('guardaMesFixo').classList.remove('hidden');
  }
  if(usuario!=='ADMIN'){
    $('guardaSelectDiv').classList.add('hidden');
  }else{
    $('guardaSelectDiv').classList.remove('hidden');
  }
  diaSelecionado=Math.min(diaSelecionado,diasNoMes());
  desenharCalendario();desenharTabela();
}

function desenharCalendario(){
  const c=$('calendario');c.innerHTML='';
  for(let d=1;d<=diasNoMes();d++){
    const k=chave(d),obj=escala[k]||{};
    const qtd=usuario==='ADMIN'?Object.keys(obj).length:Object.values(obj).filter(x=>x===usuario).length;
    const outro=usuario!=='ADMIN' && Object.values(obj).some(v=>v && v!==usuario);
    const b=document.createElement('button');
    b.type='button';
    let cls='day'+(d===diaSelecionado?' selected ':'')+(qtd?' has':'');
    if(outro)cls+=' outro';
    b.className=cls;
    b.innerHTML=String(d).padStart(2,'0')+(qtd?`<small>✓ ${qtd}</small>`:'<small> </small>');
    b.onclick=()=>{diaSelecionado=d;desenharCalendario()};
    c.appendChild(b);
  }
}

function desenharTabela(){
  const t=$('tabela');
  const table=t.closest('table');
  const thead=table.querySelector('thead');
  thead.innerHTML='';t.innerHTML='';
  const n=diasNoMes();
  const h=document.createElement('tr');
  h.innerHTML='<th class="fixo posto-col">Posto</th><th class="fixo horario-col">Horário</th>';
  for(let d=1;d<=n;d++){
    const th=document.createElement('th');
    const data=new Date(ano(),mesAtual(),d);
    th.innerHTML=`${String(d).padStart(2,'0')}<small>${diasSemanaLetra[data.getDay()]}</small>`;
    if(d===diaSelecionado)th.className='dia-atual';
    th.onclick=()=>{diaSelecionado=d;desenhar()};
    h.appendChild(th);
  }
  thead.appendChild(h);
  let total=0, totalMe=0;
  for(const p of postos){
    const tr=document.createElement('tr');
    tr.innerHTML=`<td class="fixo posto-col"><b>${p}</b></td><td class="fixo horario-col">07:30–18:30</td>`;
    for(let d=1;d<=n;d++){
      const k=chave(d),g=(escala[k]||{})[p]||'';
      const meu=g===usuario;
      const outro=g && g!==usuario;
      if(meu)totalMe++;
      if(g && (usuario==='ADMIN' || meu))total++;
      const td=document.createElement('td');
      if(d===diaSelecionado)td.className='dia-atual';
      if(g){
        td.innerHTML=`<span>${g.replace('GUARDA ','G. ')}</span>`;
        if(usuario==='ADMIN'){
          const b=document.createElement('button');
          b.className='mini-excluir';b.type='button';b.textContent='×';b.title='Excluir';
          b.onclick=e=>{e.stopPropagation();excluir(k,p)};
          td.appendChild(b);
        }
        if(outro && usuario!=='ADMIN')td.classList.add('bloqueado');
      }else td.innerHTML='<span class="vazio">—</span>';
      td.onclick=()=>{
        if(outro && usuario!=='ADMIN'){mostrar('⛔ Já preenchido por outro guarda — não pode alterar.');return;}
        diaSelecionado=d;
        $('posto').value=p;$('postoFixo').value=p;
        if(usuario==='ADMIN' && g)$('guarda').value=g;
        desenhar();
      };
      tr.appendChild(td);
    }
    t.appendChild(tr);
  }
  $('resumo').innerHTML=usuario==='ADMIN'
    ?`<b>${total}</b> marcações no mês.`
    :`Suas marcações: <b>${totalMe}</b> · Outros já preenchidos estão bloqueados 🔒`;
}

function entrar(){
  if($('senhaLogin').value!=='123456'){
    $('loginMsg').textContent='Senha incorreta. Use 123456.';
    $('loginMsg').classList.remove('hidden');return;
  }
  usuario=$('usuarioLogin').value;
  $('login').classList.add('hidden');$('app').classList.remove('hidden');
  $('usuarioNome').textContent=usuario;
  $('perfil').textContent=usuario==='ADMIN'?'ADMINISTRADOR':'GUARDA-VÍDAS';
  $('guarda').value=usuario==='ADMIN'?guardas[0]:usuario;
  desenhar();
}

function salvar(){
  if(!usuario)return;
  const k=chave(diaSelecionado);
  const p=$('posto').value || $('postoFixo').value;
  const g=usuario==='ADMIN'?$('guarda').value:usuario;
  if(!escala[k])escala[k]={};
  // BLOQUEIO: Guarda não sobrescreve o que outro já marcou
  if(escala[k][p] && escala[k][p]!==usuario && usuario!=='ADMIN'){
    mostrar('⛔ Este posto/dia já foi preenchido por outro guarda — não pode alterar.');return;
  }
  escala[k][p]=g;
  localStorage.setItem(KEY,JSON.stringify(escala));
  mostrar(`✅ Salvo: Posto ${p} — Dia ${String(diaSelecionado).padStart(2,'0')} — ${g}`);
  desenhar();
}

function excluir(k,p){
  if(usuario!=='ADMIN')return;
  if(escala[k]){delete escala[k][p];if(!Object.keys(escala[k]).length)delete escala[k];}
  localStorage.setItem(KEY,JSON.stringify(escala));desenhar();
}

function fixarMes(){
  localStorage.setItem(KEY_MES_FIXO, $('mesFixo').value);
  mostrar(`📌 Mês ${meses[$('mesFixo').value]} fixado para todos os guardas!`);
  desenhar();
}

function mostrar(txt){
  $('msg').textContent=txt;$('msg').classList.remove('hidden');
  setTimeout(()=>$('msg').classList.add('hidden'),4000);
}

function sair(){
  usuario=null;$('app').classList.add('hidden');$('login').classList.remove('hidden');$('senhaLogin').value='';
}

// Eventos
$('mes').onchange=()=>{diaSelecionado=Math.min(diaSelecionado,diasNoMes());desenhar();};
$('fixarMesBtn').onclick=fixarMes;
$('entrarBtn').onclick=entrar;
$('senhaLogin').onkeydown=e=>{if(e.key==='Enter')entrar()};
$('salvarBtn').onclick=salvar;
$('sairBtn').onclick=sair;
$('limparBtn').onclick=()=>{$('posto').selectedIndex=0;$('postoFixo').selectedIndex=0;};
$('btnPDF').onclick=exportarPDF;
$('btnXLS').onclick=exportarXLS;

preencherSelects();
</script></body></html>
